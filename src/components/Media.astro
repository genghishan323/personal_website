---
// Shows an optimized image, or a placeholder tile with the same shape.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  aspect?: string;
  label?: string;
  sizes?: string;
  eager?: boolean;
  showLabel?: boolean;
}

const { image, alt = '', aspect = '3 / 2', label = 'Image', sizes = '(max-width: 720px) 100vw, 33vw', eager = false, showLabel = true } = Astro.props;
// Sizes up to 2400px wide; the JPG fallback is capped too, so originals are never shipped.
const widths = image ? [640, 1280, 2400].filter((w) => w < image.width) : [];
if (image && widths.length === 0) widths.push(image.width);
const maxWidth = widths.at(-1);
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths}
      width={maxWidth}
      height={Math.round((maxWidth! * image.height) / image.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      class="media"
      style={`aspect-ratio: ${aspect}`}
    />
  ) : (
    <div class="media placeholder" style={`aspect-ratio: ${aspect}`} role="img" aria-label={`${label} placeholder`}>
      {showLabel && <span>{label}</span>}
    </div>
  )
}

<style>
  .media {
    width: 100%;
    object-fit: cover;
    border-radius: 2px;
    background: var(--tile);
  }

  .placeholder {
    display: grid;
    place-items: center;
    border: 1px dashed var(--rule);
  }

  .placeholder span {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
